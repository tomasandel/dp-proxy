api.jvgc-a.com {
	reverse_proxy 127.0.0.1:{$API_PORT:3000}
}

loga.jvgc-a.com {
	@monitor remote_ip 127.0.0.1 ::1
	reverse_proxy @monitor 127.0.0.1:{$LOG_A_PUBLIC_PORT:8082}
	reverse_proxy 127.0.0.1:{$LOG_A_ATTACK_PORT:8081}
}

logb.jvgc-a.com {
	@monitor remote_ip 127.0.0.1 ::1
	reverse_proxy @monitor 127.0.0.1:{$LOG_B_PUBLIC_PORT:8084}
	reverse_proxy 127.0.0.1:{$LOG_B_ATTACK_PORT:8083}
}

logs.jvgc-a.com {
	root * /srv
	file_server
}
